# Copy to terraform.tfvars (gitignored) and fill in.

aws_region     = "eu-central-1"
domain_name    = "underling.example.com"
hosted_zone_id = "Z0123456789ABCDEFGHIJ"

# The tag make image-push pushed; tags are immutable.
image_tag = "0123456789ab"

sentry_github_repos = "4501234567890123=acme/app"

anthropic_model     = "global.anthropic.claude-sonnet-4-5-20250929-v1:0"
codex_bedrock_model = "openai.gpt-oss-120b"

# Optional; null (the default) leaves the env var out so the app's default holds.
# investigation_timeout      = "30m"
# anthropic_small_fast_model = "global.anthropic.claude-haiku-4-5-20251001-v1:0"
# codex_bedrock_region       = "us-west-2"

# Service sizing (defaults shown).
# task_cpu              = 2048
# task_memory           = 8192
# ephemeral_storage_gib = 30
